# 开放平台调用凭证，只放在服务端环境变量或此文件中，不要提交。
ZHIHU_ACCESS_SECRET=
# 仅本地 pnpm dev / pnpm dev:api 使用：未登录时以当前项目 ACS 读取个人数据；生产环境保持关闭。
ZHIHU_DEV_USER_DATA=0
# 应用对外公开来源。OAuth 回调固定为 <PUBLIC_ORIGIN>/api/auth/callback，
# 登记到开放平台的就是这个完整地址（本机预览填 http://127.0.0.1:4301，线上填 https://gustfeng.dev）。
PUBLIC_ORIGIN=
# 知乎 OAuth 登录凭证（项目提报入口发放后填写；app_id、app_key 与公开来源齐全才启用登录）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 可选：写完整回调地址，应用只取其中的来源部分；与 PUBLIC_ORIGIN 二者其一即可
ZHIHU_OAUTH_REDIRECT_URI=
# 网页端共享 KV（Redis）：登录会话、限流计数，以及热榜与个人档案的跨实例缓存。
# Vercel 部署必须配置：Serverless 实例之间不共享内存，缺省回退进程内存只在本地单实例联调可用，
# 且会让个人档案在每个冷启动实例里重复全量扫描（一次最坏上百次上游调用）。
# 从 Marketplace 装 Upstash for Redis 集成会让 Vercel 自动注入 UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN，无需手填；下面两个是旧 Vercel KV 的名字，应用按同样优先级识别。
# 本地联调也可手工填其中任意一组（在 Upstash 控制台 REST API 区域可复制）。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 旧 Vercel KV 命名；两套都认，任填一组即可。
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 网页端额度保护：登录后消耗额度的接口（直答、众声）按会话与来源地址限流。
# 只作用于这些接口，热榜/内容流靠 CDN 共享缓存，不进限流。
WEB_RATE_LIMIT_MAX=20
WEB_RATE_LIMIT_WINDOW_SECONDS=60
# 概念动画：把概念/一句话生成单文件讲解动画。模型走 OpenAI 兼容端点（chat/completions）。
# 未单独配置时回退到深度研究的 MODEL_API_KEY / MODEL_API_BASE_URL / MODEL_PROFILE_MODEL_ID。
# 生成代码类内容对模型能力敏感，建议用较强的编码模型。
ANIMATION_MODEL_API_KEY=
ANIMATION_MODEL_BASE_URL=
ANIMATION_MODEL_ID=
ANIMATION_MODEL_PROVIDER=
# 以下三项可选，缺省即用默认值。
ANIMATION_MODEL_TEMPERATURE=0.8
ANIMATION_MODEL_MAX_TOKENS=
ANIMATION_MODEL_TIMEOUT_MS=300000
