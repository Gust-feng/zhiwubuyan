# 开放平台调用凭证，只放在本机环境变量或此文件中，不要提交。
ZHIHU_ACCESS_SECRET=
# 仅本地 pnpm dev / pnpm dev:api 使用：未登录时以当前项目 ACS 读取个人数据；生产环境保持关闭。
ZHIHU_DEV_USER_DATA=0
# 知乎 OAuth 登录凭证（项目提报入口发放后填写；三个值齐全登录能力才启用）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
# 知乎社区 API 凭据（app_key 为用户 token，app_secret 为开放平台发放的应用密钥）
ZHIHU_COMMUNITY_APP_KEY=
ZHIHU_COMMUNITY_APP_SECRET=
# 网页端登录会话存储（Vercel KV 集成自动注入；仅 Vercel 部署需要，本地开发用进程内存）
KV_REST_API_URL=
KV_REST_API_TOKEN=
