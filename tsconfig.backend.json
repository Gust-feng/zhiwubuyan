{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/agent/**/*.ts",
    "src/storage/**/*.ts",
    "src/contracts/**/*.ts",
    "src/application/**/*.ts",
    "src/platform/**/*.ts",
    "src/server/**/*.ts",
    "src/cli/**/*.ts",
    "src/backend/**/*.ts",
    "api/**/*.ts"
  ]
}
